#!/usr/bin/env python3
"""A stand-in for the `recipe` command, for running recipe-gui from a checkout.

It answers the commands the front end uses (see ../README.md, "What the front
end asks of recipe") from catalog.json and a small state file, and plays an
install as a stream of events. Nothing is downloaded, built or installed.

It tells the places software can be in apart the way the real `recipe` does
(tools/recipe, `system_route` and `default_package_root`):

  recipe --system install|update|remove NAME   the system route. On an A/B system the booted root is
                                               locked and the change is written into the OTHER root;
                                               it prints {action, package, packages, other_root,
                                               other_mount, running_root, active_now: false,
                                               in_other_root, effects}. On a computer with one root
                                               it is written into the running root (active at once)
                                               and prints {action, package, packages, root, receipt,
                                               kept_config, new_config_beside, accounts_created,
                                               var_seeded, present, effects}.
  recipe --system installed --json             on A/B: {booted: {root, packages}, other: {root,
                                               mount, packages}, not_done: [{package, error}]};
                                               with one root: {root, packages}. Each package is
                                               {name, version, recipe, recipe_digest, dependencies,
                                               sessions}, and the base is {name: "base", version,
                                               serial, release: true, ...}
  recipe ... --package-root DIR                one explicit store (installed.json)
  recipe ...                                   the person's own store (installed-me.json)

Environment:
  RECIPE_STANDIN_STATE    folder for the state file (default: a folder in /tmp)
  RECIPE_STANDIN_LOG      file each invocation's arguments are appended to, one JSON
                          line each (default: invocations.log in the state folder)
  RECIPE_STANDIN_AB       0: `--system` is a computer with one root (`{root, packages}`, written into that root)
  RECIPE_STANDIN_EFFECTS  failed: after a system change the rebuilding of the root's caches (the effects recipe) fails:
                          the change is written, the final answer says `effects.status: "failed"`, and the command
                          exits with an error, as the real `recipe --system` does
  RECIPE_STANDIN_HOST_OS  the os-release ID of this system, for ABOUT.systems (default levitateos)
  RECIPE_STANDIN_NOT_DONE "NAME:error text": `--system installed` lists that system change as
                          not done (wiped by `recab copy`, writing it again failed)
  RECIPE_STANDIN_HOST_LIBC  this system's C library, as `recipe list --json` says it in host_libc (default glibc)
  RECIPE_STANDIN_LINGER   seconds the command stays alive after its last event (`done`), as a
                          recipe that tears its sandbox down slowly does
  RECIPE_STANDIN_INFO     nofile: `recipe info` does not print the Recipe: line
  RECIPE_STANDIN_SLOW_READS  seconds `list`, `installed` and `updates` take before they answer
  RECIPE_STANDIN_SPEED    time factor for an install; 0 runs it at once (default 1)
  RECIPE_STANDIN_STOP_AT  "name:hook": stay in the middle of that step forever
  RECIPE_STANDIN_REFUSE_NEW  a recipe whose install (not yet installed) the sandbox refuses,
                          as it refuses Element's update
  RECIPE_STANDIN_FIXED    "element": Element's update is no longer refused (its source fixed it)
  RECIPE_STANDIN_STOP_AT  also "name:remove": stay in the middle of that short change forever; so do
                          "refresh:refresh", "source:add" and "source:remove"
  RECIPE_STANDIN_FAIL     "KIND:NAME" or "KIND": that short change (remove, refresh,
                          source-add, source-remove) fails with plain output lines and recipe's own message, as
                          a store that cannot be written to does

It keeps a profile for each store (`profile` in its answers, `<store>/profile`; for the person's own store
`<state>/me/profile`): `bin/NAME` for every program an installed package lists, and `share/applications/NAME.desktop`
for every menu entry, each program a small script that notes "NAME started from PATH" in `started.log` in the
state folder, so that a check can see what "Open" started and from where.

It also keeps what the real `recipe` keeps beside a store (tools/recipe, packages.rs and
packages/history.rs): the history of what was done to it (`recipe history --json`, one line
per change, newest first).
"""
import datetime
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
CATALOG = json.load(open(os.path.join(HERE, "catalog.json")))
STATE_DIR = os.environ.get("RECIPE_STANDIN_STATE") or "/tmp/recipe-standin-%d" % os.getuid()
STATE = os.path.join(STATE_DIR, "installed.json")  # main() picks the store the arguments name
SYSTEM = os.path.join(STATE_DIR, "system.json")
ME = os.path.join(STATE_DIR, "installed-me.json")
AB = os.environ.get("RECIPE_STANDIN_AB", "1") != "0"
HOST_OS = os.environ.get("RECIPE_STANDIN_HOST_OS", "levitateos")
EFFECTS = os.environ.get("RECIPE_STANDIN_EFFECTS", "")
ONE_ROOT = os.path.join(STATE_DIR, "installed-one-root.json")  # the running root of a computer with one root
BASE_VERSION = "1.1"
# Desktop sessions a system package provides (the real list counts the .desktop files of usr/share/wayland-sessions
# and usr/share/xsessions among its files).
SESSIONS = {"plasma": 2, "lxqt": 1}
EFFECTS_ERROR = ("glib-compile-schemas: cannot write /usr/share/glib-2.0/schemas/gschemas.compiled: "
                 "Read-only file system (os error 30)")
HOST_LIBC = os.environ.get("RECIPE_STANDIN_HOST_LIBC", "glibc")
LINGER = float(os.environ.get("RECIPE_STANDIN_LINGER", "0"))
SLOW_READS = float(os.environ.get("RECIPE_STANDIN_SLOW_READS", "0"))
STORE_ROOT = "/var/lib/recipe"  # the profile named in answers
SPEED = float(os.environ.get("RECIPE_STANDIN_SPEED", "1"))
STOP_AT = os.environ.get("RECIPE_STANDIN_STOP_AT", "")
FAIL = os.environ.get("RECIPE_STANDIN_FAIL", "")
PROFILE = STORE_ROOT + "/profile"  # main() sets the profile of the store the arguments name
MACHINE_EVENTS = False


def installed():
    if not os.path.exists(STATE):
        os.makedirs(STATE_DIR, exist_ok=True)
        # The person's own store starts with one program of their own,
        # an older version of it; the others' store is the catalog's.
        save(ME_START if STATE == ME else ONE_ROOT_START if STATE == ONE_ROOT else CATALOG["installed"])
    items = json.load(open(STATE))
    sync_profile(items)
    return items


def main_program(item):
    """The program a menu entry of the package starts: the one named like the entry, else like the package."""
    programs = [path[4:] for path in item.get("files", []) if path.startswith("bin/")]
    for path in item.get("files", []):
        if path.startswith("share/applications/") and path.endswith(".desktop"):
            wanted = os.path.basename(path)[:-8]
            if wanted in programs:
                return wanted
    return item["name"] if item["name"] in programs else (programs[0] if programs else item["name"])


def sync_profile(items):
    """Makes the files the receipts list: a program is a script that notes it was started, from where."""
    started = os.path.join(STATE_DIR, "started.log")
    for item in items:
        for path in item.get("files", []):
            target = os.path.join(PROFILE, path)
            if os.path.exists(target):
                continue
            if path.startswith("bin/"):
                os.makedirs(os.path.dirname(target), exist_ok=True)
                with open(target, "w") as out:
                    out.write('#!/bin/sh\necho "$(basename "$0") started from $0, PATH begins with ${PATH%%%%:*}" >> "%s"\n' % started)
                os.chmod(target, 0o755)
            elif path.startswith("share/applications/") and path.endswith(".desktop"):
                os.makedirs(os.path.dirname(target), exist_ok=True)
                with open(target, "w") as out:
                    out.write("[Desktop Entry]\nType=Application\nName=%s\nExec=%s %%U\nIcon=%s\n"
                              % (item["name"], main_program(item), item["name"]))


def unsync_profile(item):
    for path in item.get("files", []):
        if path.startswith("bin/") or path.startswith("share/applications/"):
            try:
                os.remove(os.path.join(PROFILE, path))
            except OSError:
                pass


ME_START = [{
    "name": "tree", "version": "2.3.1", "installed_on": 1793275200, "size_bytes": 3145728,
    "recipe": os.path.expanduser("~/.local/share/recipe/recipes/tree.rhai"),
    "files": ["bin/tree"],
}]


# What a computer with one root holds to begin with: the others' software, and a desktop with its libraries.
ONE_ROOT_START = CATALOG["installed"] + [
    {"name": name, "version": version, "installed_on": 1793188800, "size_bytes": 1 << 20,
     "recipe": "/usr/share/recipe/recipes/%s.rhai" % name, "files": []}
    for name, version in (("desktop-libs", "1.0.0"), ("plasma", "6.5.2"))]


def save(items):
    with open(STATE, "w") as out:
        json.dump(items, out, indent=1)


def history_path():
    return STATE + ".history.jsonl"


def record(what, package=None, before=None, after=None, source=None):
    """One line of the store's history, in the real fields (history.rs `HistoryEntry`)."""
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(history_path(), "a") as out:
        out.write(json.dumps({"at": int(time.time()), "what": what, "package": package, "from": before,
                              "to": after, "source": source}) + "\n")


def remote_source(name):
    """The source's name for a recipe of a remote source; the real entry is null for a folder."""
    for each in listed_sources():
        if each["name"] == recipes_source(name) and each["kind"] == "remote":
            return each["name"]
    return None


def history():
    if not os.path.exists(history_path()):
        return []
    lines = [json.loads(line) for line in open(history_path()) if line.strip()]
    return list(reversed(lines))


# ---------------------------------------------------------------- sources
# Two to begin with: the catalog the image ships as a remote source, and the
# person's own folder.

SOURCES = os.path.join(STATE_DIR, "sources.json")
OWN = os.path.expanduser("~/.local/share/recipe/recipes")


def read(path, default):
    if not os.path.exists(path):
        return default
    return json.load(open(path))


def write(path, value):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(path, "w") as out:
        json.dump(value, out, indent=1)


def sources():
    first = [{"name": "levitate", "title": CATALOG["source"]["title"], "kind": "remote",
              "address": "https://raw.githubusercontent.com/LevitateOS/recipes/{rev}/{path}", "branch": "main",
              "commit": "4c1d9e07", "checked": int(time.time()) - 3 * 3600, "problem": None}]
    return read(SOURCES, first)


def listed_sources():
    own = {"name": "local", "title": None, "kind": "folder", "path": OWN, "checked": None, "problem": None}
    return [own] + sources()


def sample(name, title, description, category, like):
    """A recipe for a source added by hand: shaped like one of the catalog's."""
    made = dict(next(item for item in CATALOG["recipes"] if item["name"] == like))
    made.update(name=name, description=description)
    made["about"] = dict(made.get("about") or {}, category=category, title=title, kind="tool")
    return made


def mismatch(item, parent=None, seen=None):
    """The message Recipe's install gives for a recipe whose declared C library is not this system's, for the
    recipe or one it needs when it runs; None when it can run here."""
    seen = seen if seen is not None else []
    if item["name"] in seen:
        return None
    seen.append(item["name"])
    about = item.get("about") or {}
    systems = about.get("systems")
    if systems and HOST_OS not in systems:
        text = ("%s: it is made for the systems %s (os-release ID); this system is %s (ID=%s), which it does not list."
                % (item["name"], ", ".join(systems), HOST_OS, HOST_OS))
        if parent:
            text += " %s is a dependency of %s." % (item["name"], parent)
        return text + " To install it anyway: recipe install --any-system %s" % (parent or item["name"])
    libc = about.get("libc")
    if libc and HOST_LIBC != "unknown" and HOST_LIBC not in libc:
        build = " or ".join(libc)
        if about.get("libc_carried"):
            text = ("%s: its build is linked against %s, and its package brings its own %s and loader; this "
                    "system's C library is %s. The package was made and tried on %s systems; on %s it has not "
                    "been tried." % (item["name"], build, build, HOST_LIBC, build, HOST_LIBC))
        else:
            text = ("%s: its build is linked against %s; this system's C library is %s, so as packaged its "
                    "program would find no loader." % (item["name"], build, HOST_LIBC))
        if parent:
            text += " %s is a dependency of %s." % (item["name"], parent)
        return text + " To install it anyway: recipe install --any-libc %s" % (parent or item["name"])
    for dep in item.get("deps", []):
        found = next((each for each in CATALOG["recipes"] if each["name"] == dep), None)
        if found and (why := mismatch(found, parent or item["name"], seen)):
            return why
    return None


def recipes():
    found = []
    for item in CATALOG["recipes"]:
        # `tree` is the one in in the person's own folder.
        why = mismatch(item)
        found.append(dict(item, source="local" if item["name"] == "tree" else "levitate", path=recipe_file(item["name"]),
                          runs_here=why is None, not_runnable_reason=why))
    for source in sources():
        if source["name"] == "levitate" or source.get("problem"):
            continue
        found.append(dict(sample("fastfetch", "Fastfetch", "Shows what this computer is, at a glance", "utilities",
                                 "tree"), source=source["name"]))
        found.append(dict(sample("zellij", "Zellij", "Several terminals in one window", "utilities", "htop"),
                          source=source["name"]))
    return found


RECIPE_TEXT = """// the stand-in's recipe for %(name)s
/* what a recipe says about itself */
const ABOUT = #{
    kind: "tool",
    title: "%(name)s",
    libc: ["glibc"],
};

fn install(ctx) {
    let programs = 3;
    if programs > 2 {
        print("putting the files in place");
    }
    return true;
}
"""


def recipe_file(name):
    """The recipe's file, as the real `list --json` names it: made here so there is one to open."""
    path = os.path.join(STATE_DIR, "recipes", name + ".rhai")
    if not os.path.exists(path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as out:
            out.write(RECIPE_TEXT % {"name": name})
    return path


def source_add(args, words):
    known = sources()
    if "--path" in args:
        folder = words[2]
        name = os.path.basename(folder.rstrip("/"))
        made = {"name": name, "title": None, "kind": "folder", "path": folder, "checked": None, "problem": None}
    else:
        address = words[2]
        if not address.startswith("https://"):
            fail("a source is fetched over https; %s is not such an address" % address)
        name = address.rstrip("/").split("/")[-2] if address.rstrip("/").count("/") >= 4 else "source"
        made = {"name": name, "title": "%s recipes" % name.capitalize(), "kind": "remote", "address": address,
                "branch": "main", "commit": "9a02b7f1", "checked": int(time.time()), "problem": None}
    if name in ("local", "image") or any(each["name"] == name for each in known):
        fail("a source named %s exists already" % name)
    stop_here("source", "add")
    breaks("source-add")
    pause(0.6)
    write(SOURCES, known + [made])


def source_remove(name):
    known = sources()
    if not any(each["name"] == name for each in known):
        fail("no source named %s" % name)
    stop_here("source", "remove")
    breaks("source-remove")
    write(SOURCES, [each for each in known if each["name"] != name])


def refresh(name):
    known = sources()
    if name and not any(each["name"] == name for each in known):
        fail("no source named %s" % name)
    stop_here("refresh", "refresh")
    breaks("refresh")
    pause(0.8)
    for each in known:
        if each["kind"] == "remote" and name in ("", each["name"]):
            each["checked"] = int(time.time())
    write(SOURCES, known)


def recipes_source(name):
    return next((item["source"] for item in recipes() if item["name"] == name), None)


def recipe(name):
    name = name.split(":", 1)[-1]  # SOURCE:NAME; the stand-in's names are unique
    for item in recipes():
        if item["name"] == name:
            return item
    fail("no recipe named %s" % name)


def fail(text):
    sys.stderr.write(json.dumps({"event": "failed", "reason": text}) + "\n")
    sys.exit(1)


def breaks(kind, name=None):
    """A short change that fails when the story asks it to: plain lines, then recipe's own message."""
    if FAIL not in (kind, "%s:%s" % (kind, name)):
        return
    sys.stderr.write("recipe: %s%s\n" % (kind.replace("-", " "), " " + name if name else ""))
    reason = ("cannot switch the active profile of %s: Permission denied (os error 13)" % os.path.dirname(PROFILE)
              if name else "could not fetch the list of levitate: connection timed out")
    if MACHINE_EVENTS and name:
        emit(event="failed", recipe=name, hook=None, reason=reason)
    else:
        sys.stderr.write("Error: %s\n" % reason)
    sys.exit(1)


def emit(**event):
    sys.stderr.write(json.dumps(event) + "\n")
    sys.stderr.flush()


def pause(seconds):
    if SPEED > 0:
        time.sleep(seconds * SPEED)


def stop_here(name, hook):
    if STOP_AT == "%s:%s" % (name, hook):
        while True:
            time.sleep(3600)


def steps_of(item):
    steps = ["acquire"] if item.get("sources") else []
    steps += [hook for hook in ("build", "install") if hook in item["hooks"]]
    return steps


def hook_event(name, hook, status, msg):
    """One lifecycle event as the real recipe sends it."""
    emit(event="recipe-hook", recipe=name, hook=hook, status=status, msg=msg)


def play(item, refuse=None):
    name = item["name"]
    # Each recipe says which of its steps it needs this time, once its checks have run.
    emit(event="plan", recipe=name, steps=steps_of(item))
    for hook in steps_of(item):
        hook_event(name, hook, "running", "executing recipe hook")
        if hook == "acquire":
            sys.stderr.write("recipe: fetching %s %s from %s\n" % (name, item["version"], next(iter(item["sources"]))))
            total = max(item["needs"]["network_max_bytes"] // 4, 1 << 20)
            for part in range(1, 9):
                if refuse and part == 3:
                    hook_event(name, hook, "failed", "connection refused by the sandbox")
                    # `refused` is asked for: the real recipe names the step and its own message only.
                    emit(event="failed", recipe=name, hook=hook,
                         reason="connection refused by the sandbox",
                         refused={"endpoint": refuse, "declared": item["needs"]["network"]})
                    linger()
                    sys.exit(1)
                emit(event="fetch", recipe=name, source=next(iter(item["sources"])),
                     bytes=total * part // 8, total=total)
                pause(0.25)
        elif hook == "build":
            count = 24 if item["about"]["kind"] == "library" else 60
            for done in range(1, count + 1):
                emit(event="output", recipe=name,
                     line="[%d/%d] Compiling C object %s.p/src_part%03d.c.o" % (done, count, name, done))
                emit(event="progress", recipe=name, done=done, total=count)
                if done == count * 2 // 3:
                    stop_here(name, hook)
                pause(0.08)
        else:
            emit(event="say", recipe=name, text="Putting the files in place")
            pause(0.5)
        hook_event(name, hook, "success", "step finished")


def install(name, update_only=False):
    item = recipe(name)
    items = installed()
    current = next((each for each in items if each["name"] == name), None)
    order = [recipe(dep) for dep in item["build_deps"]] + [item]
    # The real recipe says where it keeps the run's log, in a plain line, as the run begins.
    logs = os.path.join(STATE_DIR, "logs", "%s-%d" % (name, int(time.time() * 1000)))
    os.makedirs(logs, exist_ok=True)
    open(os.path.join(logs, "worker.log"), "w").write("the stand-in's worker log\n")
    sys.stderr.write("recipe: diagnostics: %s\n" % logs)
    emit(event="plan", recipes=[{"name": each["name"], "steps": steps_of(each)} for each in order])
    # The sample story: the newer Element recipe reaches for a host it has not declared.
    # The real `recipe` reports the numeric address Ginux's audit names, never a host name.
    # RECIPE_STANDIN_REFUSE_NEW names a recipe whose first install is refused the same way.
    # RECIPE_STANDIN_FIXED=element: its source has since published a recipe that does not.
    refuse = ("203.0.113.9:443" if (name == "element" and current and os.environ.get("RECIPE_STANDIN_FIXED") != name)
              or (not current and name == os.environ.get("RECIPE_STANDIN_REFUSE_NEW")) else None)
    for each in order:
        play(each, refuse if each is item else None)
    about = item["about"].get("adds", {})
    entry = {
        "name": name, "version": item["version"],
        "recipe": "/usr/share/recipe/recipes/%s.rhai" % name,
        "files": ["bin/" + program for program in about.get("programs", [])]
                 + ["share/applications/%s.desktop" % name for _ in about.get("menu", [])[:1]],
        "installed_on": int(time.time()),
        "size_bytes": 62914560,
    }
    if remote_source(name):
        entry["source"] = remote_source(name)
        entry["commit"] = next(each["commit"] for each in listed_sources() if each["name"] == entry["source"])
    if current:
        entry["size_bytes"] = current["size_bytes"]
        items.remove(current)
    items.append(entry)
    sync_profile([entry])
    save(sorted(items, key=lambda each: each["name"]))
    record("update" if update_only else "install", name, current["version"] if current else None, item["version"],
           remote_source(name))
    emit(event="done", recipe=name)
    linger()


def storage():
    """What `recipe storage` says: what is installed."""
    items = installed()
    answer = {"schema_version": 1, "active_bytes": sum(each.get("size_bytes") or 0 for each in items),
              "profile": PROFILE}
    print(json.dumps(answer))


def remove(name):
    items = installed()
    current = next((each for each in items if each["name"] == name), None)
    if not current:
        fail("%s is not installed" % name)
    sys.stderr.write("recipe: removing %s %s\n" % (name, current["version"]))
    stop_here(name, "remove")
    breaks("remove", name)
    pause(0.4)
    items.remove(current)
    unsync_profile(current)
    save(items)
    record("remove", name, current["version"], None, remote_source(name))
    emit(event="done", recipe=name)


def updates():
    found = []
    for each in installed():
        if not any(item["name"] == each["name"] for item in recipes()):
            continue  # the problems list says so, as the real `recipe updates` does
        newer = recipe(each["name"])["version"]
        if newer != each["version"]:
            # As the real `recipe updates`: only the fields of NEEDS that differ,
            # and null where nothing was recorded at install.
            found.append({"name": each["name"], "source": "levitate", "from": each["version"], "to": newer,
                          "reason": "version", "changes": CATALOG["changes"].get(each["name"])})
    return found


# ---------------------------------------------------------------- the system route
# `recipe --system ...` on an A/B system: the booted root is locked, the other root is
# unlocked and is the only one written. State: what each root holds, by name and version.

OTHER_MOUNT = "/run/recab/other"


def system_state():
    if not os.path.exists(SYSTEM):
        # Two programs the running system came with; the other root starts as a copy of it.
        both = {"gimp": "3.0.4", "element": "1.12.3", "desktop-libs": "1.0.0", "plasma": "6.5.2"}
        write(SYSTEM, {"booted": {"root": "A", "packages": dict(both)}, "other": {"root": "B", "packages": dict(both)}})
    return read(SYSTEM, None)


def summary(packages):
    """The packages as `recipe --system installed --json` lists them (system_route.rs `summary`): the base
    first, as `{name: "base", version, serial, release: true, ...}` with no sessions; the others with the
    names they need and the desktop sessions they provide. The effects package and the previous kernel's
    modules are never listed."""
    found = [{"name": "base", "version": BASE_VERSION, "serial": 4, "release": True,
              "recipe": "/usr/lib/levitate/release.json", "recipe_digest": "sha256:" + "1" * 64, "dependencies": []}]
    for name, version in sorted(packages.items()):
        item = next((each for each in CATALOG["recipes"] if each["name"] == name), None)
        found.append({"name": name, "version": version, "recipe": "/usr/share/recipe/recipes/%s.rhai" % name,
                      "recipe_digest": "sha256:" + "0" * 64, "dependencies": list(item["deps"]) if item else [],
                      "sessions": SESSIONS.get(name, 0)})
    return found


def not_done():
    """System changes wiped from the other root whose writing again failed (RECIPE_STANDIN_NOT_DONE)."""
    word = os.environ.get("RECIPE_STANDIN_NOT_DONE", "")
    if not word:
        return []
    package, _, error = word.partition(":")
    return [{"package": package, "error": error or "the recipe failed; nothing was written to the other root"}]


def system_view():
    state = system_state()
    return {"booted": {"root": state["booted"]["root"], "packages": summary(state["booted"]["packages"])},
            "other": {"root": state["other"]["root"], "mount": OTHER_MOUNT, "packages": summary(state["other"]["packages"])},
            "not_done": not_done()}


def play_effects(changed=True):
    """What the real recipe does after a system change: runs the root's effects recipe, which rebuilds its
    whole-root caches (menus, icons, fonts). Its events are those of any recipe, under the name `effects`; a
    failure leaves the change written (RECIPE_STANDIN_EFFECTS=failed). Returns the `effects` of the answer."""
    if not changed:
        return {"status": "unchanged"}
    sys.stderr.write("Rebuilding the root's caches with //usr/lib/recipe/effects.rhai...\n")
    emit(event="plan", recipes=[{"name": "effects", "steps": ["install"]}])
    hook_event("effects", "install", "running", "executing recipe hook")
    pause(0.6)
    if EFFECTS == "failed":
        hook_event("effects", "install", "failed", EFFECTS_ERROR)
        emit(event="failed", recipe="effects", hook="install", reason=EFFECTS_ERROR)
        return {"status": "failed", "recipe": "usr/lib/recipe/effects.rhai", "error": EFFECTS_ERROR}
    hook_event("effects", "install", "success", "step finished")
    emit(event="done", recipe="effects")
    return {"status": "done", "recipe": "usr/lib/recipe/effects.rhai", "package": "system-effects", "files": 212}


def end_system_change(effects):
    """The answer is on standard output already. A failed effects run is the command's only failure: the exit
    status is nonzero and the last event is the effects recipe's `failed`, with no `failed` of the change."""
    if effects["status"] == "failed":
        sys.stderr.write("Error: the system change is written, but rebuilding the root's caches with "
                         "//usr/lib/recipe/effects.rhai failed: %s\nThe next system change runs it again.\n"
                         % effects["error"])
        sys.stdout.flush()
        linger()
        sys.exit(1)
    linger()


def system_change(action, name):
    state = system_state()
    other = state["other"]["packages"]
    if action in ("update", "remove") and name not in other:
        fail("%s is not installed in the other root" % name)
    if action == "install" and name in other:
        fail("%s is already in the other root" % name)
    written = [name]
    if action != "remove":
        item = recipe(name)
        # What it needs at run time and the other root lacks is written with it.
        needed = [recipe(dep) for dep in item["deps"] if dep not in other]
        order = needed + [recipe(dep) for dep in item["build_deps"]] + [item]
        emit(event="plan", recipes=[{"name": each["name"], "steps": steps_of(each)} for each in order])
        for each in order:
            play(each)
        # As the real recipe: the producer's own last event comes before the other root is written.
        emit(event="done", recipe=name)
        pause(0.6)
        for each in needed:
            other[each["name"]] = each["version"]
        other[name] = item["version"]
        written = [each["name"] for each in needed] + [name]
    else:
        pause(0.4)
        del other[name]
    write(SYSTEM, state)
    effects = play_effects()
    # The A/B answer carries what was written and how the caches ended, and nothing of the settings files,
    # accounts or state folders (tools/recipe system_route.rs, `change`).
    print(json.dumps({"action": action, "package": name, "packages": written,
                      "other_root": state["other"]["root"], "other_mount": OTHER_MOUNT,
                      "running_root": state["booted"]["root"], "active_now": False,
                      "in_other_root": name in other, "effects": effects}))
    end_system_change(effects)


def one_root_view():
    """`recipe --system installed --json` on a computer with one root (system_route.rs `root_route`)."""
    return {"root": "/", "packages": summary({each["name"]: each["version"] for each in installed()})}


def one_root_change(action, name):
    """`recipe --system install|update|remove` on a computer with one root: written into the running root,
    active at once. The answer is `root_route`'s: what was written, what was already there, the settings files
    left as they were and the new ones beside them, the accounts created, the state folders made, the effects."""
    items = installed()
    current = next((each for each in items if each["name"] == name), None)
    present, kept, beside, created, seeded = [], [], [], [], []
    if action in ("update", "remove") and not current:
        fail("%s is not installed in this system's root" % name)
    if action == "install" and current:
        fail("%s is already installed in this system's root" % name)
    if action == "remove":
        sys.stderr.write("recipe: removing %s %s\n" % (name, current["version"]))
        pause(0.4)
        items.remove(current)
        written = [name]
        record("remove", name, current["version"], None, None)
    else:
        item = recipe(name)
        names = [each["name"] for each in items]
        # What it needs at run time that the root has already is skipped; the rest is written with it.
        present = [dep for dep in item["deps"] if dep in names]
        needed = [recipe(dep) for dep in item["deps"] if dep not in names]
        order = needed + [recipe(dep) for dep in item["build_deps"]] + [item]
        emit(event="plan", recipes=[{"name": each["name"], "steps": steps_of(each)} for each in order])
        for each in order:
            play(each)
        # As the real recipe: the producer's own last event comes before the root is written.
        emit(event="done", recipe=name)
        pause(0.6)
        written = [each["name"] for each in needed] + [name]
        for each in needed + [item]:
            gone = next((old for old in items if old["name"] == each["name"]), None)
            if gone:
                items.remove(gone)
            items.append({"name": each["name"], "version": each["version"], "recipe": "/usr/share/recipe/recipes/%s.rhai" % each["name"],
                          "files": [], "installed_on": int(time.time()), "size_bytes": 1 << 20})
        record("update" if action == "update" else "install", name, current["version"] if current else None, item["version"], None)
        if item["about"]["kind"] == "system":
            # What a group of the system's own software writes besides its files.
            kept = ["etc/%s/%s.conf" % (name, name)]
            beside = ["etc/%s/%s.conf" % (name, name)]
            created = [{"package": name, "kind": "user", "name": name, "id": 990, "group": None}]
            seeded = ["var/lib/%s" % name]
    save(sorted(items, key=lambda each: each["name"]))
    effects = play_effects()
    print(json.dumps({"action": action, "package": name, "packages": written, "root": "/",
                      "receipt": "/usr/lib/recipe/system.json", "kept_config": kept,
                      "new_config_beside": [path + ".recipe-new" for path in beside], "accounts_created": created,
                      "var_seeded": seeded, "present": present, "effects": effects}))
    end_system_change(effects)


def linger():
    """The command stays alive after its last event, as a recipe that tears its sandbox down slowly does."""
    if LINGER > 0:
        time.sleep(LINGER)


def info(name):
    """`recipe info`: the file Recipe runs for the entry, and the C library line where the recipe declares one."""
    item = recipe(name)
    print("Name:        %s" % item["name"])
    print("Version:     %s" % item["version"])
    print("Description: %s" % item["description"])
    if os.environ.get("RECIPE_STANDIN_INFO") != "nofile":  # nofile: `info` does not say which file it is
        print("Recipe:      %s" % recipe_file(item["name"]))
    libc = item["about"].get("libc")
    if libc:
        loader = "/lib64/ld-linux-x86-64.so.2" if HOST_LIBC == "glibc" else "/lib/ld-musl-x86_64.so.1"
        print("C library:   its build is linked against %s; this system's C library is %s (the %s loader %s)"
              % (" or ".join(libc), HOST_LIBC, HOST_LIBC, loader))
    print("Runs:        on the host (it starts no program)")


def log(args, route):
    """Each invocation's arguments, for a check that the window asked the right thing."""
    path = os.environ.get("RECIPE_STANDIN_LOG") or os.path.join(STATE_DIR, "invocations.log")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as out:
        out.write(json.dumps({"route": route, "args": args}) + "\n")


def main(args):
    # The real recipe tells the places apart by `--system`, and by whether a store is
    # named: without one it is the person's own.
    global STATE, PROFILE, MACHINE_EVENTS
    system = "--system" in args
    root = args[args.index("--package-root") + 1] if "--package-root" in args else None
    if system and not AB:
        # One root, the running one: its software is kept in a state file of its own.
        root = os.path.join(STATE_DIR, "one-root")
        STATE = ONE_ROOT
    MACHINE_EVENTS = "--machine-events" in args
    log(args, "system" if system else "me" if root is None else "store")
    if root is None and not system:
        STATE = ME
        PROFILE = os.path.join(STATE_DIR, "me", "profile")
    elif root is not None:
        PROFILE = os.path.join(root, "profile")
    words, skip = [], False
    for arg in args:
        if skip:
            skip = False
        elif arg in ("--recipes-path", "--package-root"):
            skip = True
        elif arg == "--path":
            pass  # `source add --path FOLDER`: the folder is the next word
        elif not arg.startswith("--"):
            words.append(arg)
    command = words[0] if words else ""
    if command in ("install", "update", "remove") and len(words) == 2:
        words[1] = words[1].split(":", 1)[-1]  # SOURCE:NAME; the stand-in's names are unique
    if system and not AB:
        if command == "installed":
            if SLOW_READS > 0:
                time.sleep(SLOW_READS)
            print(json.dumps(one_root_view()))
        elif command in ("install", "update", "remove") and len(words) == 2:
            one_root_change(command, words[1])
        else:
            fail("--system supports install, update, remove, installed and isinstalled")
        return
    if system and AB:
        if command == "installed":
            if SLOW_READS > 0:
                time.sleep(SLOW_READS)
            print(json.dumps(system_view()))
        elif command in ("install", "update", "remove") and len(words) == 2:
            system_change(command, words[1])
        else:
            fail("--system supports install, update, remove, installed and isinstalled")
        return
    if command in ("list", "installed", "updates") and SLOW_READS > 0:
        time.sleep(SLOW_READS)
    if command == "info" and len(words) == 2:
        info(words[1])
    elif command == "list":
        # A recipe that cannot be read is named as `list --json` does: its path and why. One appears
        # once a second source is added, so the Sources page has something to show.
        problems = [{"path": os.path.join(STATE_DIR, "recipes", "yazi.rhai"),
                     "problem": "it names nothing to download"}] if len(sources()) > 1 else []
        print(json.dumps({"schema_version": 1, "host_libc": HOST_LIBC, "sources": listed_sources(),
                          "recipes": recipes(), "problems": problems}))
    elif command == "refresh":
        refresh(words[1] if len(words) > 1 else "")
    elif command == "source" and words[1:2] == ["add"] and len(words) == 3:
        source_add(args, words)
    elif command == "source" and words[1:2] == ["remove"] and len(words) == 3:
        source_remove(words[2])
    elif command == "installed":
        # The shape `recipe installed` has today, plus the fields the front end asks for.
        print(json.dumps({"packages": installed(), "profile": PROFILE}))
    elif command == "updates":
        print(json.dumps({"schema_version": 1, "updates": updates(),
                          "problems": [{"name": each["name"],
                                        "problem": "no recipe for it is in the collection or the sources any more"}
                                       for each in installed()
                                       if not any(item["name"] == each["name"] for item in recipes())]}))
    elif command == "storage":
        storage()
    elif command == "history":
        print(json.dumps({"schema_version": 1, "history": history()}))
    elif command in ("install", "update") and len(words) == 2:
        install(words[1], command == "update")
    elif command == "remove" and len(words) == 2:
        remove(words[1])
    else:
        sys.stderr.write("stand-in recipe: unknown command: %s\n" % " ".join(args))
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
