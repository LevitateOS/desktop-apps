#!/usr/bin/env python3
"""A stand-in for recab, for running recab-gui from a checkout. It speaks the
CLI the window uses and nothing else:

  recab status --json
  recab copy
  recab boot-other [--cancel] --json

and answers as tools/recab does (schema 11, docs/status.schema.json). It reads
and writes no disk: its state is one JSON file, RECAB_STANDIN_STATE, made from
RECAB_STANDIN_SCENARIO the first time, so `copy` and `boot-other` change what
`status` says next.

RECAB_STANDIN_SCENARIO:
  normal        A is booted and the boot default; B is mounted and can be started
  booted-b      B is booted and the boot default; A is the other root
  once          B is picked for the next boot, once
  not-mounted   the other root is not mounted
  not-bootable  a copy into the other root did not finish: it cannot be started
  no-default    the boot default names neither root
  copy-failing  as normal, but `copy` stops half way and leaves B not startable
  root-only     as normal, but `status` is refused unless RECAB_STANDIN_ROOT=1
                (what the root helper stand-in sets)
RECAB_STANDIN_SPEED scales the waiting (0: none).
"""
import json
import os
import sys
import time

SCENARIO = os.environ.get("RECAB_STANDIN_SCENARIO", "normal")
STATE = os.environ.get("RECAB_STANDIN_STATE", "")
SPEED = float(os.environ.get("RECAB_STANDIN_SPEED", "1"))
JSON = "--json" in sys.argv


def fresh():
    booted, other = ("B", "A") if SCENARIO == "booted-b" else ("A", "B")
    return {
        "schema_version": 11,
        "booted": booted,
        "other": other,
        "other_mount": None if SCENARIO == "not-mounted" else "/run/recab/other",
        "other_bootable": SCENARIO != "not-bootable",
        "boot_default": None if SCENARIO == "no-default" else booted,
        "next_boot_once": other if SCENARIO == "once" else None,
    }


def load():
    if STATE and os.path.exists(STATE):
        with open(STATE) as f:
            return json.load(f)
    state = fresh()
    save(state)
    return state


def save(state):
    if STATE:
        with open(STATE, "w") as f:
            json.dump(state, f)


def fail(code, message, klass=None):
    if JSON:
        sys.stderr.write(json.dumps({"schema_version": 11, "class": klass, "code": code, "message": message}) + "\n")
    else:
        sys.stderr.write("recab: %s%s\n" % ("[%s] " % klass if klass else "", message))
    sys.exit(code)


def say(text):
    sys.stderr.write("recab: %s\n" % text)
    sys.stderr.flush()
    time.sleep(0.3 * SPEED)


def status():
    if SCENARIO == "root-only" and os.environ.get("RECAB_STANDIN_ROOT") != "1":
        fail(13, "cannot read the boot entries: Permission denied (needs root)", "permission")
    state = load()
    if JSON:
        print(json.dumps(state, indent=2))
        return
    print("Booted root (locked, read-only): %s" % state["booted"])
    print("Other root (unlocked): %s, %s" % (state["other"], "mounted at " + state["other_mount"] if state["other_mount"] else "not mounted"))
    print("Boot default: %s" % (state["boot_default"] or "neither root"))
    print("Next boot, once: %s" % (state["next_boot_once"] or "nothing picked"))


def copy():
    state = load()
    booted, other = state["booted"], state["other"]
    say("reading the booted root %s" % booted)
    if not state["other_mount"] or not state["other_bootable"]:
        say("creating root %s's filesystem anew" % other)
    # While a copy runs the other root has no boot entry.
    state["other_bootable"] = False
    state["next_boot_once"] = None
    save(state)
    say("copying root %s into root %s" % (booted, other))
    if SCENARIO == "copy-failing":
        fail(1, "copying into root %s stopped at /usr/lib64/libLLVM.so.19: No space left on device (os error 28)" % other)
    say("writing root %s's boot files on the ESP" % other)
    state["other_bootable"] = True
    state["other_mount"] = "/run/recab/other"
    save(state)
    print("Root %s is now a copy of root %s: 8734 MiB written in 4091 ranges, 12 entries removed, 3 metadata updates." % (other, booted))


def boot_other():
    state = load()
    if "--cancel" in sys.argv:
        state["next_boot_once"] = None
        save(state)
        if JSON:
            print(json.dumps({"next_boot_once": None}))
        else:
            print("No root is picked for the next boot; the boot default starts.")
        return
    if not state["other_bootable"]:
        fail(21, "root %s has no complete boot entry; run 'recab copy' first" % state["other"], "state_or_detection")
    state["next_boot_once"] = state["other"]
    save(state)
    if JSON:
        print(json.dumps({"next_boot_once": state["other"]}))
    else:
        print("Root %s starts at the next boot, once. Reboot when ready." % state["other"])


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    command = args[0] if args else ""
    if command == "status":
        return status()
    if command == "copy":
        return copy()
    if command == "boot-other":
        return boot_other()
    sys.stderr.write("error: the stand-in recab only knows `status`, `copy` and `boot-other`\n")
    sys.exit(2)


if __name__ == "__main__":
    main()
